COMPANY_NAME="Vercel Inc."
SITE_NAME="Next.js Commerce"
SHOPIFY_REVALIDATION_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"

# SoundCloud playlist embedded in the homepage radio player.
NEXT_PUBLIC_SOUNDCLOUD_PLAYLIST_URL=""

# Meta (Facebook / Instagram) Pixel.
# Find this in Meta Events Manager -> Data Sources -> your pixel.
# Leave empty to disable tracking entirely: no scripts load and no events fire.
# For production, set the same variable in
# Vercel -> Project -> Settings -> Environment Variables.
NEXT_PUBLIC_META_PIXEL_ID=""
